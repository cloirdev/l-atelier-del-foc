---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  falla: string;
  año: number;
  lema: string;
  seccion: string;
  casal?: string;
  premios: string[];
  foto?: ImageMetadata;
}
const { falla, año, lema, seccion, casal, premios, foto } = Astro.props;
---

<article class="falla-card">
  <div class="photo">
    {
      foto ? (
        <Image src={foto} alt={`${falla}, ${año}`} />
      ) : (
        <>
          <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
            <circle
              cx="50"
              cy="30"
              r="14"
              fill="none"
              stroke="var(--wood)"
              stroke-width="2.2"
            />
            <path
              d="M28 88 C28 58 34 46 50 46 C66 46 72 58 72 88"
              fill="none"
              stroke="var(--wood)"
              stroke-width="2.2"
              stroke-linecap="round"
            />
          </svg>
          <span class="ph-label">Foto pendiente</span>
        </>
      )
    }
    <span class="año">{año}</span>
  </div>
  <div class="body">
    <p class="eyebrow">{seccion}</p>
    <h3>{falla}</h3>
    <p class="lema">"{lema}"</p>
    {casal && <p class="casal">{casal}</p>}
    {
      premios.length > 0 && (
        <ul class="premios">
          {premios.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .falla-card {
    background: var(--white-smoke);
    border-radius: 2px;
    box-shadow: 0 10px 24px -14px rgba(43, 36, 32, 0.45);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .photo {
    position: relative;
    flex-shrink: 0;
    aspect-ratio: 3/4;
    background:
      radial-gradient(
        circle at 88% 6%,
        rgba(193, 68, 14, 0.22),
        transparent 40%
      ),
      linear-gradient(155deg, var(--paper-dark), var(--cork) 130%);
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: polygon(0 0, 88% 0, 100% 14%, 100% 100%, 0 100%);
  }
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mark {
    width: 26%;
    opacity: 0.5;
  }
  .ph-label {
    position: absolute;
    bottom: 8px;
    left: 12px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--wood-dark);
    opacity: 0.6;
  }
  .año {
    position: absolute;
    top: 10px;
    left: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--wood-dark);
    background: var(--white-smoke);
    padding: 2px 8px;
    border-radius: 2px;
  }
  .body {
    padding: 16px 18px 20px;
  }
  .body .eyebrow {
    margin-bottom: 6px;
  }
  .body h3 {
    font-size: 19px;
    margin-bottom: 4px;
  }
  .lema {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--wood);
    font-size: 15px;
    margin-bottom: 8px;
  }
  .casal {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--wood);
    margin-bottom: 10px;
  }
  .premios {
    list-style: none;
    margin: 10px 0 0;
    padding: 10px 0 0;
    border-top: 1px solid rgba(74, 52, 35, 0.16);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .premios li {
    font-size: 13px;
    color: var(--soot);
    padding-left: 14px;
    position: relative;
  }
  .premios li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    background: var(--ember);
    border-radius: 50%;
  }
</style>
