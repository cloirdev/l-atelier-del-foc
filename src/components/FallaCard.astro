---
// src/components/FallaCard.astro
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import PlaceholderFrame from "./PlaceholderFrame.astro";

interface Props {
  falla: CollectionEntry<"fallas">["data"];
  href?: string; // opcional: si existe, toda la tarjeta es un enlace
  sizes?: string;
}
const { falla, href, sizes = "(max-width: 700px) 72vw, 33vw" } = Astro.props;

// "Menendez y Pelayo - Avenida Cataluña Infantil" -> nombre + calle/categoría
const [nombre, ...resto] = falla.falla.split(/\s+-\s+/);
const detalle = resto.join(" - ");
const premiada = falla.premios.length > 0;

const Tag = href ? "a" : "article";
---

<Tag class="card" href={href}>
  <div class="frame">
    {
      falla.foto ? (
        <Image
          src={falla.foto}
          alt={`${falla.falla} (${falla.año})`}
          widths={[400, 700, 1000]}
          sizes={sizes}
          class="photo"
        />
      ) : (
        <PlaceholderFrame
          label={nombre}
          caption={`${falla.año} · foto pendiente`}
          ratio="4/5"
        />
      )
    }
    <div class="chips">
      <span class="chip">{falla.año}</span>
      <span class="chip chip-soft">{falla.seccion}</span>
      {premiada && <span class="chip chip-ember">★</span>}
    </div>
  </div>

  <div class="body">
    <h3>{nombre}</h3>
    {detalle && <p class="detalle">{detalle}</p>}
    <p class="lema">{falla.lema}</p>
  </div>
</Tag>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 14px;
    background: var(--white-smoke);
    border: 1px solid color-mix(in srgb, var(--wood-dark) 14%, transparent);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.45s ease;
  }
  /* Línea de brasa que crece al pasar el ratón */
  .card::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--ember), var(--ember-light));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--soot);
  }
  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Degradado inferior para dar profundidad y legibilidad a las etiquetas */
  .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--soot) 55%, transparent) 0,
        transparent 28%
      ),
      linear-gradient(
        0deg,
        color-mix(in srgb, var(--soot) 35%, transparent) 0,
        transparent 30%
      );
  }

  .chips {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    z-index: 1;
    display: flex;
    gap: 6px;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 7px 10px;
    border-radius: 99px;
    color: var(--white-smoke);
    background: color-mix(in srgb, var(--soot) 78%, transparent);
    backdrop-filter: blur(6px);
  }
  .chip-soft {
    background: color-mix(in srgb, var(--soot) 45%, transparent);
  }
  .chip-ember {
    margin-left: auto;
    background: var(--ember);
    color: var(--white-smoke);
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px 22px;
  }
  h3 {
    margin: 0;
    font-size: 21px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .detalle {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--wood-dark) 70%, transparent);
  }
  .lema {
    margin: 10px 0 0;
    padding-left: 12px;
    border-left: 2px solid var(--ember);
    font-style: italic;
    font-size: 15px;
    line-height: 1.4;
    color: var(--wood-dark);
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-6px);
      box-shadow: 0 18px 40px -18px
        color-mix(in srgb, var(--soot) 60%, transparent);
    }
    .card:hover::after {
      transform: scaleX(1);
    }
    .card:hover .photo {
      transform: scale(1.05);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card::after,
    .photo {
      transition: none;
    }
  }
</style>
