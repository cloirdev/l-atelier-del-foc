---
// src/components/FallaCard.astro
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import PlaceholderFrame from "./PlaceholderFrame.astro";

interface Props {
  falla: CollectionEntry<"fallas">["data"];
  href?: string; // opcional: si existe, toda la tarjeta es un enlace
  sizes?: string;
  slug?: string; // opcional: por defecto se saca del href
}
const {
  falla,
  href,
  sizes = "(max-width: 700px) 72vw, 33vw",
  slug: slugProp,
} = Astro.props;

// Identificador único para la View Transition del título
// "/es/fallas/sevilla-denia/" -> "sevilla-denia"
const slug = slugProp ?? href?.split("/").filter(Boolean).pop();

// Nombre completo, tal cual está en la ficha (ej. "Sevilla - Denia Infantil")
const nombre = falla.falla;
const premiada = falla.premios.length > 0;

const Tag = href ? "a" : "article";
---

<Tag class="card" href={href}>
  <!-- Foto a sangre: ocupa toda la tarjeta -->
  <div class="media">
    {
      falla.foto ? (
        <Image
          src={falla.foto}
          alt={`${falla.falla} (${falla.año})`}
          widths={[400, 700, 1000]}
          sizes={sizes}
          class="photo"
        />
      ) : (
        <div class="placeholder">
          <PlaceholderFrame
            label={nombre}
            caption={`${falla.año} · foto pendiente`}
            ratio="4/5"
          />
        </div>
      )
    }
  </div>

  <!-- Etiquetas de cristal -->
  <div class="chips">
    <span class="chip chip-year">{falla.año}</span>
    <span class="chip">{falla.seccion}</span>
    {
      premiada && (
        <span
          class="chip chip-ember"
          title={falla.premios.join(" · ")}
          aria-label={falla.premios.join(", ")}
        >
          ★
        </span>
      )
    }
  </div>

  <!-- Título y lema sobre la imagen -->
  <div class="body">
    <h3
      style={slug ? `view-transition-name: falla-${slug}` : undefined}
      class:list={[slug && "vt-title"]}
    >
      {nombre}
    </h3>
    <p class="lema">&ldquo;{falla.lema}&rdquo;</p>
  </div>

  {
    href && (
      <span class="go" aria-hidden="true">
        ↗
      </span>
    )
  }
</Tag>

<style is:global>
  @view-transition {
    navigation: auto;
  }
  .vt-title {
    view-transition-class: falla-title;
  }
  ::view-transition-group(*.falla-title) {
    animation-duration: 0.65s;
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }
</style>

<style>
  .card {
    --soot-rgb: 27 19 13;
    position: relative;
    isolation: isolate;
    display: block;
    height: 100%;
    min-height: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px;
    background: var(--soot, rgb(var(--soot-rgb)));
    color: #fff;
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(var(--soot-rgb) / 0.2);
    transition:
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.5s ease;
  }

  /* ---------- Foto ---------- */
  .media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .placeholder {
    position: absolute;
    inset: 0;
  }

  /* Degradado: oscurece arriba (etiquetas) y mucho abajo (título) */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(
        0deg,
        rgb(var(--soot-rgb) / 0.95) 0%,
        rgb(var(--soot-rgb) / 0.78) 26%,
        rgb(var(--soot-rgb) / 0.22) 52%,
        rgb(var(--soot-rgb) / 0) 70%
      ),
      linear-gradient(
        180deg,
        rgb(var(--soot-rgb) / 0.5) 0%,
        rgb(var(--soot-rgb) / 0) 24%
      );
    transition: opacity 0.5s ease;
  }

  /* Línea de brasa que crece al pasar el ratón */
  .card::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--ember), var(--ember-light));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* ---------- Etiquetas ---------- */
  .chips {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    gap: 6px;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 7px 11px;
    border-radius: 99px;
    color: #fff;
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.22);
    -webkit-backdrop-filter: blur(10px) saturate(1.4);
    backdrop-filter: blur(10px) saturate(1.4);
  }
  .chip-year {
    background: rgb(var(--soot-rgb) / 0.55);
    border-color: rgb(255 255 255 / 0.12);
  }
  .chip-ember {
    margin-left: auto;
    background: var(--ember);
    border-color: transparent;
  }

  /* ---------- Título + lema ---------- */
  .body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 22px 24px;
    padding-right: 64px; /* deja sitio al botón de la flecha */
  }
  h3 {
    margin: 0;
    font-size: clamp(22px, 2.1vw, 28px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
    overflow-wrap: anywhere; /* nunca se corta ni desborda, aunque sea muy largo */
    text-shadow: 0 2px 24px rgb(var(--soot-rgb) / 0.5);
  }
  .lema {
    margin: 0;
    padding-left: 12px;
    border-left: 2px solid var(--ember);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 15px;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.82);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---------- Flecha ---------- */
  .go {
    position: absolute;
    right: 18px;
    bottom: 20px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 17px;
    line-height: 1;
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.28);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* ---------- Hover / foco ---------- */
  .card:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: 4px;
  }
  .card:focus-visible::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-6px);
      box-shadow: 0 26px 50px -22px rgb(var(--soot-rgb) / 0.75);
    }
    .card:hover::after {
      transform: scaleX(1);
    }
    .card:hover .photo {
      transform: scale(1.06);
    }
    .card:hover .go {
      background: var(--ember);
      border-color: var(--ember);
      transform: translate(2px, -2px) rotate(8deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card::after,
    .photo,
    .go {
      transition: none;
    }
  }
</style>
