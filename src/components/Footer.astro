---
import "@fontsource/anton";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Logo from "../assets/logo.svg";

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="col">
      <Logo width={"50px"} />
      <p class="foot-word">L'Atelier del Foc</p>
      <p class="foot-desc">
        {t("footer.descripcion")}
      </p>
    </div>
    <div class="col">
      <p class="eyebrow">Taller</p>
      <a href={`/${currentLang}/sobre-mi/`}>Sobre Dani</a>
      <a href={`/${currentLang}/servicios/`}>Servicios</a>
    </div>
    <div class="col">
      <p class="eyebrow">Contacto</p>
      <a href="mailto:latelierdelfoc@gmail.com">latelierdelfoc@gmail.com</a>
      <a href={`/${currentLang}/contacto/`}>{t("footer.contacto.mensaje")}</a>
    </div>
  </div>
  <div class="wrap bottom">
    <p>© {year} L'Atelier del Foc — Dani. Hecho a mano, como todo lo demás.</p>
    <p>Web creada por <a href="https://ottro.studio">OTTRO.STUDIO</a></p>
  </div>
</footer>
<style>
  .site-footer {
    background: var(--wood-dark);
    color: var(--paper-dark);
    padding-top: 56px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
  }
  .foot-word {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--white-smoke);
    margin-bottom: 10px;
  }
  .foot-desc {
    font-size: 14.5px;
    color: var(--cork);
    max-width: 34ch;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .col .eyebrow {
    margin-bottom: 2px;
  }
  .col a {
    font-size: 14px;
    color: var(--paper-dark);
    width: fit-content;
    border-bottom: 1px solid transparent;
  }
  .col a:hover {
    color: var(--ember-light);
    border-color: var(--ember-light);
  }
  .bottom {
    border-top: 1px solid rgba(237, 228, 211, 0.12);
    padding: 18px 28px;
  }
  .bottom p {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--cork);
  }

  .bottom p a {
    font-family: "Anton", sans-serif;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
    text-decoration: none;

    /* Estado en reposo: blanco sólido */
    color: var(--paper-dark);

    /* Gradiente preparado pero invisible */
    background-image: linear-gradient(
      90deg,
      #ff5b1f 0%,
      #5eead4 50%,
      #ff5b1f 100%
    );
    background-size: 200% 100%;
    background-position: 0% 50%;

    /* El texto empieza opaco (color natural) */
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: var(--paper-dark);
    color: var(--paper-dark);

    /* Transición suave para la entrada y la salida */
    transition:
      color 0.5s ease,
      -webkit-text-fill-color 0.5s ease;
  }

  .bottom p a:hover {
    /* Al hacer hover, el texto se vuelve transparente
     y deja ver el gradiente */
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: shift-gradient 2.5s linear infinite;
  }

  @keyframes shift-gradient {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }

  .bottom p a img {
    width: 1em;
    height: 1em;
    display: block;
  }

  .wrap bottom {
    display: flex;
  }

  @media (max-width: 680px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
