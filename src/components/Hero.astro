---
// src/components/Hero.astro
import { Image } from "astro:assets";
import heroFuego from "../assets/hero-fuego.webp";
import { languages } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: keyof typeof languages;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<script is:inline>
  document.documentElement.classList.add("js");
</script>

<section class="hero" data-hero>
  <div class="hero-media" data-reveal data-media>
    <Image
      src={heroFuego}
      alt="Foto de fuego"
      widths={[800, 1200, 1672]}
      sizes="(max-width: 900px) 150vw, 68vw"
      class="hero-photo"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-glow" data-glow></div>
  </div>

  <canvas class="hero-embers" data-embers aria-hidden="true"></canvas>

  <div class="wrap hero-inner">
    <div class="hero-copy" data-copy>
      <p class="eyebrow eyebrow-light" data-reveal data-eyebrow>
        {t("home.hero.eyebrow")}
      </p>
      <h1>
        <span class="line"
          ><span class="line-in" data-reveal data-line
            >{t("home.hero.h1.l1")}</span
          ></span
        >
        <span class="line"
          ><span class="line-in" data-reveal data-line
            >{t("home.hero.h1.l2")}</span
          ></span
        >
        <span class="line"
          ><span class="line-in" data-reveal data-line
            >{t("home.hero.h1.l3")}
            <span class="ember-word" data-ember>{t("home.hero.h1.ember")}</span
            >.</span
          ></span
        >
      </h1>
      <p class="hero-sub" data-reveal data-fade>{t("home.hero.sub")}</p>
      <div class="hero-cta" data-reveal data-fade>
        <a class="btn btn-primary" href={`/${lang}/servicios/`}
          >{t("home.hero.cta.encargar")}</a
        >
        <a class="btn btn-ghost" href={`/${lang}/galeria/`}
          >{t("home.hero.cta.galeria")}</a
        >
      </div>
    </div>
  </div>

  <span class="hero-scroll" aria-hidden="true" data-reveal data-fade></span>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  type State = { speed: number; on: boolean };

  // Brasas: canvas ligero, se pausa fuera de pantalla
  function embers(cv: HTMLCanvasElement, state: State) {
    const ctx = cv.getContext("2d")!;
    let W = 0,
      H = 0,
      dpr = 1,
      raf = 0;
    const mk = (init: boolean) => ({
      x: W * (0.25 + Math.random() * 0.75),
      y: init ? Math.random() * H : H + 10,
      r: (Math.random() * 1.8 + 0.5) * dpr,
      v: (Math.random() * 0.6 + 0.25) * dpr,
      w: Math.random() * 6.28,
      c: Math.random() < 0.5 ? "255,190,80" : "255,100,40",
    });
    const size = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = cv.width = cv.clientWidth * dpr;
      H = cv.height = cv.clientHeight * dpr;
    };
    size();
    const ps = Array.from({ length: innerWidth < 700 ? 35 : 70 }, () =>
      mk(true),
    );
    const ro = new ResizeObserver(size);
    ro.observe(cv);

    const tick = () => {
      raf = requestAnimationFrame(tick);
      if (!state.on) return;
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = "lighter";
      for (const p of ps) {
        p.y -= p.v * state.speed;
        p.w += 0.015;
        p.x += Math.sin(p.w) * 0.4 * dpr;
        const a = Math.max(0, p.y / H) * 0.85;
        ctx.fillStyle = `rgba(${p.c},${a})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, 6.283);
        ctx.fill();
        if (p.y < -10) Object.assign(p, mk(false));
      }
    };
    tick();
    return () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
    };
  }

  function initHero() {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    if (!hero) return;
    const $ = <T extends Element>(s: string) => hero.querySelector<T>(s)!;
    const $$ = (s: string) => gsap.utils.toArray<HTMLElement>(s, hero);

    const mm = gsap.matchMedia();

    // Todo lo animado solo si el usuario no pide reducir movimiento
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const media = $("[data-media]");
      const copy = $("[data-copy]");
      const ember = $("[data-ember]");
      const state: State = { speed: 1, on: true };

      // 1. Entrada: la imagen solo se desvela (sin movimiento)
      const tl = gsap.timeline();
      tl.fromTo(
        media,
        { autoAlpha: 0, filter: "blur(10px)" },
        {
          autoAlpha: 1,
          filter: "blur(0px)",
          duration: 2,
          ease: "power2.out",
          clearProps: "filter",
        },
        0,
      )
        .fromTo(
          $("[data-eyebrow]"),
          { autoAlpha: 0, y: 14 },
          { autoAlpha: 1, y: 0, duration: 0.8, ease: "power3.out" },
          0.5,
        )
        .fromTo(
          $$("[data-line]"),
          { autoAlpha: 0, yPercent: 105 },
          {
            autoAlpha: 1,
            yPercent: 0,
            duration: 1.1,
            stagger: 0.12,
            ease: "power4.out",
          },
          0.6,
        )
        .fromTo(
          $$("[data-fade]"),
          { autoAlpha: 0, y: 20 },
          {
            autoAlpha: 1,
            y: 0,
            duration: 0.9,
            stagger: 0.12,
            ease: "power3.out",
          },
          1.2,
        );

      // 2. Llama viva: respiración muy sutil
      const flames = [
        gsap.to($("[data-glow]"), {
          opacity: "random(0.8, 1)",
          duration: "random(0.9, 1.8)",
          ease: "sine.inOut",
          repeat: -1,
          yoyo: true,
          repeatRefresh: true,
        }),
        gsap.to(ember, {
          textShadow: "0 0 16px rgba(255,100,40,.5)",
          duration: "random(1.2, 2.2)",
          ease: "sine.inOut",
          repeat: -1,
          yoyo: true,
          repeatRefresh: true,
        }),
      ];

      // 3. Scroll: el texto se aparta; la imagen se queda quieta
      gsap
        .timeline({
          scrollTrigger: {
            trigger: hero,
            start: "top top",
            end: "bottom top",
            scrub: true,
            onUpdate: (self) => (state.speed = 1 + self.progress * 3),
          },
        })
        .to(copy, { y: -60, autoAlpha: 0.15, ease: "none" }, 0);

      // 4. Brasas (solo activas cuando el hero es visible)
      const st = ScrollTrigger.create({
        trigger: hero,
        start: "top bottom",
        end: "bottom top",
        onToggle: (self) => (state.on = self.isActive),
      });
      const stopEmbers = embers($<HTMLCanvasElement>("[data-embers]"), state);

      return () => {
        stopEmbers();
        st.kill();
        flames.forEach((f) => f.kill());
      };
    });
  }

  initHero();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: calc(100svh - 58px);
    background: var(--soot);
    color: var(--white-smoke);
  }

  /* Imagen: alejada, anclada abajo a la derecha y fundida con el fondo */
  .hero-media {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(68%, 1250px);
    z-index: 0;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0, #000 30%),
      linear-gradient(180deg, transparent 0, #000 30%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0, #000 30%),
      linear-gradient(180deg, transparent 0, #000 30%);
    mask-composite: intersect;
  }
  .hero-photo {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(
      55% 60% at 70% 85%,
      rgba(255, 90, 31, 0.32),
      transparent
    );
  }

  /* Velo lateral para asegurar contraste del texto */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      var(--soot) 0,
      color-mix(in srgb, var(--soot) 80%, transparent) 28%,
      transparent 60%
    );
  }

  .hero-embers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: 72px;
    padding-bottom: 88px;
  }

  .hero-copy {
    max-width: 40rem;
  }
  .eyebrow-light {
    color: var(--ember-light);
  }
  h1 {
    color: var(--white-smoke);
    font-size: clamp(40px, 6.4vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 16px 0 24px;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .line-in {
    display: block;
  }
  .ember-word {
    color: var(--ember);
    font-style: italic;
    text-shadow: 0 0 10px rgba(255, 100, 40, 0.35);
  }
  .hero-sub {
    max-width: 46ch;
    font-size: 17.5px;
    color: var(--cork);
    margin-bottom: 32px;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .hero .btn-ghost {
    color: var(--white-smoke);
    border-color: currentColor;
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 3;
    width: 1px;
    height: 44px;
    background: linear-gradient(var(--ember-light), transparent);
  }

  /* El contenido solo se oculta si hay JS y no se pide reducir movimiento;
     GSAP lo revela al empezar la entrada. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero [data-reveal] {
      visibility: hidden;
    }
  }

  @media (max-width: 900px) {
    .hero {
      align-items: flex-end;
      min-height: calc(100svh - 64px);
    }
    .hero-media {
      width: 150%;
      right: -40%;
      top: 0;
      bottom: auto;
      -webkit-mask-image: linear-gradient(180deg, #000 45%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 45%, transparent 100%);
    }
    .hero::after {
      background: linear-gradient(0deg, var(--soot) 12%, transparent 72%);
    }
    .hero-inner {
      padding-top: 40vh;
      padding-bottom: 56px;
    }
    .hero-scroll {
      display: none;
    }
  }
</style>
