---
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { languages } from "../../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

import falla1 from "../../../assets/servicios/fallas-infantiles/falla-1.jpg";
import falla2 from "../../../assets/servicios/fallas-infantiles/falla-2.jpg";
import falla3 from "../../../assets/servicios/fallas-infantiles/falla-3.jpg";

import ninot1 from "../../../assets/servicios/ninots/ninot-1.png";
import ninot2 from "../../../assets/servicios/ninots/ninot-2.png";
import ninot3 from "../../../assets/servicios/ninots/ninot-3.png";

import batidoFallero from "../../../assets/servicios/batidos/batido-fallero.png";
import batidoFontanero from "../../../assets/servicios/batidos/batido-fontanero.png";
import batidoIndigena from "../../../assets/servicios/batidos/batido-indigena.png";
import batidoMedusa from "../../../assets/servicios/batidos/batido-medusa.png";
import batidoMonje from "../../../assets/servicios/batidos/batido-monje.png";
import batidoRojo from "../../../assets/servicios/batidos/batido-rojo.png";

import poster1 from "../../../assets/servicios/ilustraciones/poster-1.jpg";
import lamina1 from "../../../assets/servicios/ilustraciones/lamina-1.jpg";
import poster2 from "../../../assets/servicios/ilustraciones/poster-2.jpg";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isVa = lang === "va";
const verProceso = isVa ? "Veure el procés" : "Ver proceso";

/* ---------- Datos ---------- */
const proceso = [1, 2, 3, 4].map((n) => ({
  n: String(n).padStart(2, "0"),
  label: t(`serv.proc.${n}.label` as any),
  text: t(`serv.proc.${n}.text` as any),
}));

type Item = { img: ImageMetadata; es: string; va: string; video?: string };

const fallasData: Item[] = [
  {
    img: falla1,
    es: "Falla infantil, casal Sevilla-Denia",
    va: "Falla infantil, casal Sevilla-Denia",
  },
  {
    img: falla2,
    es: "Falla infantil, casal Trinidad-Alboraya",
    va: "Falla infantil, casal Trinitat-Alboraia",
  },
  {
    img: falla3,
    es: "Falla infantil, casal Carrer de San Luis",
    va: "Falla infantil, casal Carrer de Sant Lluís",
  },
];

const ninotsData: Item[] = [
  {
    img: ninot1,
    es: "Ninot individual, encargo particular",
    va: "Ninot individual, encàrrec particular",
  },
  {
    img: ninot2,
    es: "Ninot individual, pieza de colección",
    va: "Ninot individual, peça de col·lecció",
  },
  {
    img: ninot3,
    es: "Ninot individual, regalo personalizado",
    va: "Ninot individual, regal personalitzat",
  },
];

const batidosData: Item[] = [
  { img: batidoFallero, es: "Batido Fallero", va: "Batut Faller" },
  { img: batidoFontanero, es: "Batido Fontanero", va: "Batut Fontaner" },
  { img: batidoIndigena, es: "Batido Indígena", va: "Batut Indígena" },
  { img: batidoMedusa, es: "Batido Medusa", va: "Batut Medusa" },
  { img: batidoMonje, es: "Batido Monje", va: "Batut Monjo" },
  { img: batidoRojo, es: "Batido Rojo", va: "Batut Roig" },
];

const ilustracionesData: Item[] = [
  {
    img: poster1,
    es: "Cartel de falla",
    va: "Cartell de falla",
    video: "/videos/poster-1-proceso.mp4",
  },
  { img: lamina1, es: "Lámina decorativa", va: "Làmina decorativa" },
  { img: poster2, es: "Póster de comisión", va: "Pòster de comissió" },
];

const toItems = (data: Item[]) =>
  data.map((d) => ({
    title: isVa ? d.va : d.es,
    img: d.img,
    video: d.video ?? null,
  }));

/* Tamaños de imagen según el tipo de galería */
const imgCfg = {
  bento: { widths: [480, 720, 960], sizes: "(max-width: 900px) 92vw, 460px" },
  baraja: {
    widths: [480, 720, 960, 1200],
    sizes: "(max-width: 900px) 80vw, 500px",
  },
  float: {
    widths: [320, 480, 640, 800],
    sizes: "(max-width: 900px) 45vw, 340px",
  },
} as const;

const secciones = [
  { id: "fallas", layout: "baraja", tono: "paper", items: toItems(fallasData) },
  { id: "ninots", layout: "baraja", tono: "sand", items: toItems(ninotsData) },
  {
    id: "batidos",
    layout: "float",
    tono: "oscuro",
    items: toItems(batidosData),
  },
  {
    id: "ilustraciones",
    layout: "baraja",
    tono: "paper",
    items: toItems(ilustracionesData),
  },
].map((s, i) => ({
  ...s,
  n: String(i + 1).padStart(2, "0"),
  title: t(`serv.${s.id}.title` as any),
  text: t(`serv.${s.id}.text` as any),
  invertido: i % 2 === 1 && s.layout !== "float",
  cfg: imgCfg[s.layout as keyof typeof imgCfg],
}));
---

<Layout title={t("serv.title")} description={t("serv.lede")}>
  <!-- ============ HERO ============ -->
  <section class="serv-hero">
    <div class="wrap">
      <h1>{t("serv.title")}</h1>
      <p class="lede">{t("serv.lede")}</p>

      <nav class="chips" aria-label={t("serv.title")}>
        {
          secciones.map((s) => (
            <a href={`#${s.id}`}>
              <span>{s.n}</span>
              {s.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- ============ SERVICIOS ============ -->
  {
    secciones.map((s) => (
      <section
        id={s.id}
        class={`servicio servicio--${s.tono}${s.invertido ? " servicio--invertido" : ""}`}
      >
        <div
          class={`wrap servicio-grid${s.layout === "float" ? " servicio-grid--arriba" : ""}`}
        >
          <div class="servicio-texto">
            <span class="num" aria-hidden="true">
              {s.n}
            </span>
            <h2>{s.title}</h2>
            <p class="texto">{s.text}</p>
            <p class="precio-nota">{t("serv.precio.nota")}</p>
            <a class="enlace" href={`/${lang}/contacto/`}>
              {t("serv.cta.button")} →
            </a>
          </div>

          <div class="servicio-galeria">
            {s.layout === "float" && (
              <p class="galeria-label">{t("serv.batidos.galeria.title")}</p>
            )}
            <div class={`galeria galeria--${s.layout}`}>
              {s.items.map((it) => (
                <figure class="media">
                  {it.video ? (
                    <div class="marco marco-video">
                      <Image
                        src={it.img}
                        alt={it.title}
                        widths={s.cfg.widths as unknown as number[]}
                        sizes={s.cfg.sizes}
                        format="webp"
                        loading="lazy"
                      />
                      <video
                        class="hover-video"
                        src={it.video}
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-hidden="true"
                        tabindex="-1"
                      />
                      <span class="play" aria-hidden="true">
                        ▶ {verProceso}
                      </span>
                    </div>
                  ) : (
                    <div class="marco">
                      <Image
                        src={it.img}
                        alt={it.title}
                        widths={s.cfg.widths as unknown as number[]}
                        sizes={s.cfg.sizes}
                        format="webp"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <figcaption>{it.title}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- ============ PROCESO ============ -->
  <section class="section proceso">
    <div class="wrap">
      <h2 class="proc-title">{t("serv.proc.title")}</h2>
      <ol class="steps">
        {
          proceso.map((p) => (
            <li class="step">
              <span class="step-n">{p.n}</span>
              <h3>{p.label}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section cta">
    <div class="wrap cta-inner">
      <h2>{t("serv.cta.title")}</h2>
      <p>{t("serv.cta.text")}</p>
      <a class="btn btn-primary" href={`/${lang}/contacto/`}>
        {t("serv.cta.button")}
      </a>
    </div>
  </section>
</Layout>

<script>
  /* ---------- Barajas (ninots e ilustraciones) ---------- */
  const INTERVALO_MS = 4500; // tiempo entre cartas (en milisegundos)
  const TRANSICION_MS = 720; // duración de la salida de la carta
  const textoSiguiente =
    document.documentElement.lang === "va" ? "Següent" : "Siguiente";

  document
    .querySelectorAll<HTMLElement>(".galeria--baraja")
    .forEach((baraja) => {
      const cartas = Array.from(baraja.querySelectorAll<HTMLElement>(".media"));
      if (cartas.length < 2) return;

      let orden = [...cartas];
      let animando = false;
      let visible = false;
      let encima = false;
      let timer: number | undefined;

      const colocar = () =>
        orden.forEach((c, i) => c.style.setProperty("--pos", String(i)));

      // Cartas con vídeo: reproducir / detener (solo suena la de delante)
      const videos = new Map<
        HTMLElement,
        { reproducir: () => void; detener: () => void; activo: () => boolean }
      >();

      /* Controles: puntos + botón siguiente */
      const ctrl = document.createElement("div");
      ctrl.className = "baraja-ctrl";
      const puntos = document.createElement("div");
      puntos.className = "baraja-dots";
      puntos.setAttribute("aria-hidden", "true");
      cartas.forEach(() => puntos.appendChild(document.createElement("span")));
      const sig = document.createElement("button");
      sig.type = "button";
      sig.className = "baraja-next";
      sig.textContent = "→";
      sig.setAttribute("aria-label", textoSiguiente);
      ctrl.append(puntos, sig);
      baraja.after(ctrl);

      const marcarPuntos = () => {
        const idx = cartas.indexOf(orden[0]);
        puntos
          .querySelectorAll("span")
          .forEach((p, i) => p.classList.toggle("on", i === idx));
      };

      const siguiente = () => {
        if (animando) return;
        animando = true;
        const frente = orden[0];
        videos.get(frente)?.detener();
        frente.classList.add("sale");
        orden = orden.slice(1);
        colocar();
        marcarPuntos();
        setTimeout(() => {
          // La carta vuelve al fondo de la baraja sin animar el regreso
          frente.classList.add("sin-trans");
          frente.classList.remove("sale");
          orden.push(frente);
          frente.style.setProperty("--pos", String(orden.length - 1));
          void frente.offsetWidth;
          frente.classList.remove("sin-trans");
          animando = false;
          // Si el ratón ya estaba sobre la nueva carta de delante, arranca su vídeo
          if (orden[0].matches(":hover")) videos.get(orden[0])?.reproducir();
        }, TRANSICION_MS);
      };

      const reducido = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const parar = () => {
        clearInterval(timer);
        timer = undefined;
      };
      const arrancar = () => {
        parar();
        if (reducido || !visible || encima) return;
        timer = window.setInterval(siguiente, INTERVALO_MS);
      };

      const tactil = matchMedia("(hover: none)").matches;

      cartas.forEach((c) => {
        const marco = c.querySelector<HTMLElement>(".marco-video");
        const video = c.querySelector<HTMLVideoElement>(".hover-video");

        if (marco && video) {
          const reproducir = () => {
            if (c !== orden[0]) return;
            video
              .play()
              .then(() => marco.classList.add("reproduciendo"))
              .catch(() => {});
          };
          const detener = () => {
            video.pause();
            video.currentTime = 0;
            marco.classList.remove("reproduciendo");
          };
          videos.set(c, {
            reproducir,
            detener,
            activo: () => marco.classList.contains("reproduciendo"),
          });
          c.addEventListener("mouseenter", reproducir);
          c.addEventListener("mouseleave", detener);
        }

        c.addEventListener("click", () => {
          const v = videos.get(c);
          // En pantallas táctiles no hay hover: tocar la carta con vídeo lo activa
          if (tactil && v && c === orden[0]) {
            if (v.activo()) v.detener();
            else v.reproducir();
            return;
          }
          siguiente();
          arrancar();
        });
      });
      sig.addEventListener("click", () => {
        siguiente();
        arrancar();
      });

      // Pausa al pasar el ratón por encima y cuando no está en pantalla
      baraja.addEventListener("mouseenter", () => {
        encima = true;
        parar();
      });
      baraja.addEventListener("mouseleave", () => {
        encima = false;
        arrancar();
      });
      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          arrancar();
        },
        { threshold: 0.35 },
      ).observe(baraja);

      colocar();
      marcarPuntos();
    });
</script>

<style>
  .serv-hero,
  .servicio--oscuro,
  .cta {
    --oscuro-rgb: 27 19 13;
    --oscuro: rgb(var(--oscuro-rgb));
  }

  .wrap {
    max-width: 1240px;
  }

  .serv-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--oscuro);
    color: var(--paper);
    padding: clamp(72px, 10vw, 140px) 0 clamp(56px, 7vw, 96px);
  }
  .serv-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        60% 90% at 88% 0%,
        color-mix(in srgb, var(--ember) 38%, transparent),
        transparent 70%
      ),
      radial-gradient(
        40% 60% at 0% 100%,
        color-mix(in srgb, var(--ember) 14%, transparent),
        transparent 70%
      );
  }
  .serv-hero h1 {
    font-size: clamp(44px, 8vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: #fff;
    max-width: 12ch;
    margin: 14px 0 24px;
    text-wrap: balance;
  }
  .serv-hero .lede {
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.75);
    max-width: 58ch;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 44px;
  }
  .chips a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.03em;
    color: #fff;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .chips a span {
    color: var(--ember);
    transition: color 0.2s ease;
  }
  .chips a:hover {
    background: var(--ember);
    border-color: var(--ember);
  }
  .chips a:hover span {
    color: #fff;
  }

  /* =========================================================
     SECCIONES DE SERVICIO
     ========================================================= */
  .servicio {
    padding: clamp(64px, 9vw, 120px) 0;
  }
  .servicio--paper {
    background: var(--paper);
  }
  .servicio--sand {
    background: var(--paper-dark);
  }
  .servicio--oscuro {
    background: var(--oscuro);
    color: var(--paper);
  }

  .servicio-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }
  .servicio--invertido .servicio-texto {
    order: 2;
  }
  /* Variante con el texto arriba y la galería debajo a todo el ancho */
  .servicio-grid--arriba {
    grid-template-columns: 1fr;
    gap: 56px;
  }
  .servicio-grid--arriba .servicio-texto {
    position: static;
    max-width: 62ch;
  }

  .num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(64px, 9vw, 120px);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--ember);
    margin-bottom: 22px;
  }
  .servicio-texto h2 {
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 10px 0 18px;
  }
  .texto {
    color: var(--wood-dark);
    font-size: 17px;
    line-height: 1.65;
    max-width: 48ch;
    margin: 0;
  }
  .precio-nota {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.03em;
    color: var(--ember);
    margin: 22px 0 24px;
  }
  .enlace {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--wood-dark);
    padding-bottom: 3px;
    border-bottom: 1px solid var(--ember);
    transition:
      color 0.2s ease,
      letter-spacing 0.2s ease;
  }
  .enlace:hover {
    color: var(--ember);
    letter-spacing: 0.07em;
  }

  /* Variante oscura */
  .servicio--oscuro .servicio-texto h2 {
    color: #fff;
  }
  .servicio--oscuro .texto {
    color: rgb(255 255 255 / 0.72);
  }
  .servicio--oscuro .enlace {
    color: #fff;
  }
  .servicio--oscuro .enlace:hover {
    color: var(--ember);
  }

  /* =========================================================
     GALERÍAS
     ========================================================= */
  .galeria {
    display: grid;
    gap: 20px;
  }
  .media {
    margin: 0;
  }
  .marco {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--cork);
    border-radius: var(--radius-sm);
    background: var(--white-smoke);
  }
  .marco :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .media:hover .marco :global(img) {
    transform: scale(1.04);
  }
  .media figcaption {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--wood-dark);
    padding: 12px 2px 0;
  }

  /* --- Fallas: foto grande a la izquierda + dos a la derecha, sin recortar --- */
  .galeria--bento {
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }
  .galeria--bento .media:nth-child(1) {
    grid-row: 1 / span 2;
  }

  /* --- Ninots e ilustraciones: baraja de cartas que rota sola ---
     Cada carta tiene una posición (--pos): 0 = delante, 1, 2... = detrás.
     El script la actualiza y el CSS se encarga de la animación. */
  .galeria--baraja {
    position: relative;
    display: block;
    width: min(calc(100% - 72px), 500px);
    aspect-ratio: 4 / 5.3; /* tamaño de las cartas: cámbialo aquí */
    margin: 56px 0 28px;
  }
  .galeria--baraja .media {
    --pos: 0;
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    background: var(--white-smoke);
    border: 1px solid var(--cork);
    border-radius: var(--radius-sm);
    box-shadow:
      0 22px 44px rgb(27 19 13 / 0.2),
      0 2px 6px rgb(27 19 13 / 0.12);
    z-index: calc(20 - var(--pos));
    transform-origin: 20% 100%;
    transform: translate(calc(var(--pos) * 22px), calc(var(--pos) * -18px))
      rotate(calc(var(--pos) * 2.4deg)) scale(calc(1 - var(--pos) * 0.045));
    opacity: clamp(0, calc(4 - var(--pos)), 1);
    transition:
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.6s ease;
    cursor: pointer;
  }
  .galeria--baraja .marco {
    position: absolute;
    inset: 0;
    border: 0;
    border-radius: 0;
    background: none;
  }
  .galeria--baraja .marco :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* El pie de foto va sobre la imagen, con un degradado para que se lea */
  .galeria--baraja figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 56px 20px 18px;
    text-align: left;
    color: #fff;
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.5);
    background: linear-gradient(
      0deg,
      rgb(27 19 13 / 0.78) 0%,
      rgb(27 19 13 / 0) 100%
    );
    pointer-events: none;
  }
  /* La carta de delante sale volando y vuelve al fondo */
  .galeria--baraja .media.sale {
    z-index: 30;
    transform: translate(115%, -8%) rotate(14deg);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.7s cubic-bezier(0.5, 0, 0.8, 0.4),
      opacity 0.7s ease;
  }
  .galeria--baraja .media.sin-trans {
    transition: none !important;
  }
  /* Las fotos de fallas son más anchas: carta más cuadrada y algo mayor */
  #fallas .galeria--baraja {
    width: min(calc(100% - 72px), 560px);
    aspect-ratio: 4 / 4.3;
  }

  .baraja-ctrl {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .baraja-dots {
    display: flex;
    gap: 8px;
  }
  .baraja-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cork);
    opacity: 0.45;
    transition:
      width 0.3s ease,
      background 0.3s ease,
      opacity 0.3s ease;
  }
  .baraja-dots span.on {
    width: 26px;
    border-radius: 999px;
    background: var(--ember);
    opacity: 1;
  }
  .baraja-next {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--cork);
    background: transparent;
    color: var(--wood-dark);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
