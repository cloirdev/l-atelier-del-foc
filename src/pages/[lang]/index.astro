---
import Layout from "../../layouts/Layout.astro";
import FallaCard from "../../components/FallaCard.astro";
import GaleriaAcordeon from "@/components/GaleriaAcordeon.astro";
import Hero from "../../components/Hero.astro";
import { Image } from "astro:assets";
import heroImage from "../../assets/hero-image.webp";
import imgFalla from "@/assets/fallas/2026/menendez-pelayo/img4.webp";
import imgNinot from "@/assets/servicios/ninots/ninot-2.png";
import imgFigura from "@/assets/servicios/batidos/batido-fallero.png";
import imgLamina from "@/assets/servicios/ilustraciones/poster-2.jpg";
import { languages } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: keyof typeof languages };
const t = useTranslations(lang);

const servicios = [
  {
    n: "01",
    id: "fallas",
    img: imgFalla,
    alt: t("home.services.fallas.title"),
    titulo: t("home.services.fallas.title"),
    subtitulo: t("home.services.fallas.text"),
  },
  {
    n: "02",
    id: "ninots",
    img: imgNinot,
    alt: t("home.services.ninots.title"),
    titulo: t("home.services.ninots.title"),
    subtitulo: t("home.services.ninots.text"),
  },
  {
    n: "03",
    id: "figuras-3d",
    img: imgFigura,
    contain: true,
    alt: t("home.services.figuras3d.title"),
    titulo: t("home.services.figuras3d.title"),
    subtitulo: t("home.services.figuras3d.text"),
  },
  {
    n: "04",
    id: "laminas",
    img: imgLamina,
    alt: t("home.services.laminas.title"),
    titulo: t("home.services.laminas.title"),
    subtitulo: t("home.services.laminas.text"),
  },
];

const title = "L'Atelier del Foc";
const description = "Taller de arte fallero";
---

<Layout title={title} description={description}>
  <Hero lang={lang} />

  <section class="section about-teaser">
    <div class="wrap about-grid">
      <div class="about-media">
        <Image
          src={heroImage}
          alt={t("home.about.imgAlt")}
          widths={[480, 800]}
          sizes="(max-width: 900px) 100vw, 40vw"
          loading="lazy"
        />
      </div>
      <div class="about-copy">
        <p class="eyebrow">{t("home.about.eyebrow")}</p>
        <h2>{t("home.about.title")}</h2>
        <p>{t("home.about.text")}</p>
        <a class="btn btn-ghost" href={`/${lang}/sobre-mi/`}>
          {t("home.about.cta")}
        </a>
      </div>
    </div>
  </section>

  <section class="section services" id="servicios">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>{t("home.services.title")}</h2>
        </div>
        <a class="btn btn-primary" href={`/${lang}/contacto/`}>
          {t("home.services.cta")}
        </a>
      </div>

      <GaleriaAcordeon items={servicios} />
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap cta-inner">
      <h2>{t("home.cta.title")}</h2>
      <p>{t("home.cta.text")}</p>
      <a class="btn btn-primary" href={`/${lang}/contacto/`}>
        {t("home.cta.button")}
      </a>
    </div>
  </section>
</Layout>

<style>
  .eyebrow-light {
    color: var(--ember-light);
  }

  /* Sobre mí */
  .about-teaser {
    background: var(--paper-dark);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: center;
  }
  .about-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 12px;
  }
  .about-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-copy h2 {
    font-size: clamp(26px, 3.2vw, 34px);
    margin: 10px 0 18px;
  }
  .about-copy p:not(.eyebrow) {
    color: var(--wood-dark);
    margin-bottom: 22px;
    max-width: 52ch;
  }

  /* Cabecera común de sección */
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .section-head h2 {
    font-size: clamp(26px, 3.2vw, 36px);
    margin-top: 8px;
  }

  /* Servicios */
  .services {
    background: var(--wood-dark);
    color: var(--paper-dark);
  }
  .services .section-head h2 {
    color: var(--white-smoke);
    max-width: 22ch;
  }

  /* Cierre */
  .cta-band {
    background: var(--soot);
    padding: 80px 0 92px;
  }
  .cta-inner {
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
  }
  .cta-inner h2 {
    color: var(--white-smoke);
    font-size: clamp(28px, 3.6vw, 40px);
    margin-bottom: 16px;
  }
  .cta-inner p {
    color: var(--cork);
    margin-bottom: 30px;
    font-size: 16px;
  }
  .cta-inner .btn {
    background-color: var(--wood);
    border: transparent;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-media {
      max-width: 360px;
      margin-inline: auto;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const [targets, trigger] of [
      [".acordeon-track .acordeon-col", ".acordeon-track"],
    ]) {
      gsap.from(targets, {
        y: 36,
        autoAlpha: 0,
        duration: 0.9,
        stagger: 0.12,
        ease: "power3.out",
        scrollTrigger: { trigger, start: "top 80%" },
      });
    }
  }
</script>
