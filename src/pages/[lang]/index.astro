---
import Layout from "../../layouts/Layout.astro";
import BurntDivider from "../../components/BurntDivider.astro";
import PlaceholderFrame from "../../components/PlaceholderFrame.astro";
import { Image } from "astro:assets";
import heroImage from "../../assets/hero-image.png";
import { languages } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: keyof typeof languages };
const t = useTranslations(lang);

const steps = [
  { n: "01", label: t("home.process.step1.label"), text: t("home.process.step1.text") },
  { n: "02", label: t("home.process.step2.label"), text: t("home.process.step2.text") },
  { n: "03", label: t("home.process.step3.label"), text: t("home.process.step3.text") },
  { n: "04", label: t("home.process.step4.label"), text: t("home.process.step4.text") },
];

const piezas = [
  { label: t("home.gallery.piece1.label"), caption: t("home.gallery.piece1.caption") },
  { label: t("home.gallery.piece2.label"), caption: t("home.gallery.piece2.caption") },
  { label: t("home.gallery.piece3.label"), caption: t("home.gallery.piece3.caption") },
];
---

<Layout title="Inicio" description="">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t("home.hero.eyebrow")}</p>
        <h1>
          {t("home.hero.h1.l1")}<br />
          {t("home.hero.h1.l2")}<br />
          {t("home.hero.h1.l3")} <span class="ember-word">{t("home.hero.h1.ember")}</span>.
        </h1>
        <p class="hero-sub">{t("home.hero.sub")}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`/${lang}/servicios/`}>{t("home.hero.cta.encargar")}</a>
          <a class="btn btn-ghost" href={`/${lang}/galeria/`}>{t("home.hero.cta.galeria")}</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-photo-wrap">
          <Image
            src={heroImage}
            alt="Dani, artista fallero, en su taller"
            width={480}
            height={560}
            class="hero-photo"
          />
        </div>
      </div>
    </div>
  </section>

  <BurntDivider fill="var(--paper-dark)" />

  <section class="section about-teaser">
    <div class="wrap about-grid">
      <PlaceholderFrame
        label="Dani en el taller"
        caption="Retrato · pendiente"
        ratio="4/5"
      />
      <div class="about-copy">
        <p class="eyebrow">{t("home.about.eyebrow")}</p>
        <h2>{t("home.about.title")}</h2>
        <p>{t("home.about.text")}</p>
        <a class="btn btn-ghost" href={`/${lang}/el-artista/`}>{t("home.about.cta")}</a>
      </div>
    </div>
  </section>

  <BurntDivider fill="var(--wood-dark)" flip />

  <section class="section process" id="proceso">
    <div class="wrap">
      <p class="eyebrow eyebrow-light">{t("home.process.eyebrow")}</p>
      <h2 class="process-title">{t("home.process.title")}</h2>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step">
              <span class="step-n">{s.n}</span>
              <h3>{s.label}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <BurntDivider fill="var(--paper)" />

  <section class="section gallery-teaser">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t("home.gallery.eyebrow")}</p>
          <h2>{t("home.gallery.title")}</h2>
        </div>
        <a class="btn btn-ghost" href={`/${lang}/galeria/`}>{t("home.gallery.cta")}</a>
      </div>
      <div class="pieces-grid">
        {
          piezas.map((p) => (
            <PlaceholderFrame label={p.label} caption={p.caption} ratio="4/5" />
          ))
        }
      </div>
    </div>
  </section>

  <BurntDivider fill="var(--soot)" flip />

  <section class="cta-band">
    <div class="wrap cta-inner">
      <h2>{t("home.cta.title")}</h2>
      <p>{t("home.cta.text")}</p>
      <a class="btn btn-primary" href={`/${lang}/contacto/`}>{t("home.cta.button")}</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: var(--paper);
    padding: 72px 0 64px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: center;
  }
  .hero-copy h1 {
    font-size: clamp(38px, 5.4vw, 62px);
    margin: 14px 0 22px;
  }
  .ember-word {
    color: var(--ember);
    font-style: italic;
  }
  .hero-sub {
    max-width: 46ch;
    font-size: 17.5px;
    color: var(--wood-dark);
    margin-bottom: 30px;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .hero-photo-wrap {
    position: relative;
    width: 100%;
    max-width: 380px;
  }

  .hero-photo {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px; /* quita esto si quieres la foto también circular */
  }

  .about-teaser {
    background: var(--paper-dark);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: center;
  }
  .about-copy h2 {
    font-size: clamp(26px, 3.2vw, 34px);
    margin: 10px 0 18px;
  }
  .about-copy p:not(.eyebrow) {
    color: var(--wood-dark);
    margin-bottom: 22px;
    max-width: 52ch;
  }

  .process {
    background: var(--wood-dark);
    color: var(--paper-dark);
  }
  .eyebrow-light {
    color: var(--ember-light);
  }
  .process-title {
    color: var(--white-smoke);
    font-size: clamp(26px, 3.2vw, 36px);
    margin: 10px 0 44px;
    max-width: 20ch;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .step {
    border-top: 2px solid var(--ember);
    padding-top: 16px;
  }
  .step-n {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ember-light);
    margin-bottom: 10px;
  }
  .step h3 {
    color: var(--white-smoke);
    font-size: 20px;
    margin-bottom: 8px;
  }
  .step p {
    color: var(--cork);
    font-size: 14.5px;
  }

  .gallery-teaser {
    background: var(--paper);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .section-head h2 {
    font-size: clamp(26px, 3.2vw, 34px);
    margin-top: 8px;
  }
  .pieces-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .cta-band {
    background: var(--soot);
    padding: 80px 0 92px;
  }
  .cta-inner {
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
  }
  .cta-inner h2 {
    color: var(--white-smoke);
    font-size: clamp(28px, 3.6vw, 40px);
    margin-bottom: 16px;
  }
  .cta-inner p {
    color: var(--cork);
    margin-bottom: 30px;
    font-size: 16px;
  }
  .cta-inner .btn-primary {
  }

  @media (max-width: 900px) {
    .hero-grid,
    .about-grid {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      order: -1;
      max-width: 220px;
      margin: 0 auto;
    }
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .pieces-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .pieces-grid {
      grid-template-columns: 1fr;
    }
  }
</style>