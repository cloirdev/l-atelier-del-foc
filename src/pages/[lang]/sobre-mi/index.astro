---
import Layout from "../../../layouts/Layout.astro";
import BurntDivider from "../../../components/BurntDivider.astro";
import { Image } from "astro:assets";
import fotoDani from "../../../assets/greek-dani.webp";
import { languages } from "../../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const hitos = [
  { year: "2013", text: t("sobremi.hito1") },
  { year: "2017", text: t("sobremi.hito2") },
  { year: "2021", text: t("sobremi.hito3") },
  { year: "2024", text: t("sobremi.hito4") },
];
---

<Layout title={t("sobremi.title")} description={t("sobremi.desc")}>
  <section class="hero-page">
    <div class="wrap hero-page-grid">
      <div>
        <p class="eyebrow">{t("sobremi.eyebrow")}</p>
        <h1>{t("sobremi.h1")}</h1>
        <p class="lede">{t("sobremi.lede")}</p>
      </div>
      <Image src={fotoDani} alt="Foto de Daniel López" width="300" />
    </div>
  </section>

  <BurntDivider fill="var(--paper-dark)" />

  <section class="section bio">
    <div class="wrap bio-grid">
      <div class="bio-copy">
        <h2>{t("sobremi.bio.h2")}</h2>
        <p>{t("sobremi.bio.p1")}</p>
        <p>{t("sobremi.bio.p2")}</p>
        <p>{t("sobremi.bio.p3")}</p>
      </div>
      <aside class="bio-facts">
        <p class="eyebrow">{t("sobremi.materiales.eyebrow")}</p>
        <ul>
          <li>{t("sobremi.materiales.1")}</li>
          <li>{t("sobremi.materiales.2")}</li>
          <li>{t("sobremi.materiales.3")}</li>
          <li>{t("sobremi.materiales.4")}</li>
          <li>{t("sobremi.materiales.5")}</li>
        </ul>
      </aside>
    </div>
  </section>

  <BurntDivider fill="var(--wood-dark)" flip />

  <section class="section timeline">
    <div class="wrap">
      <p class="eyebrow eyebrow-light">{t("sobremi.timeline.eyebrow")}</p>
      <h2 class="timeline-title">{t("sobremi.timeline.title")}</h2>
      <ol class="hitos">
        {
          hitos.map((h) => (
            <li>
              <span class="hito-year">{h.year}</span>
              <p>{h.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <BurntDivider fill="var(--paper)" />

  <section class="section cta-simple">
    <div class="wrap cta-simple-inner">
      <h2>{t("sobremi.cta.title")}</h2>
      <a class="btn btn-primary" href={`/${lang}/servicios/`}>{t("sobremi.cta.button")}</a>
    </div>
  </section>
</Layout>
<style>
  .hero-page {
    background: var(--paper);
    padding: 64px 0 0;
  }
  .hero-page-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: end;
    padding-bottom: 56px;
  }
  h1 {
    font-size: clamp(44px, 6vw, 72px);
    margin: 12px 0 18px;
  }
  .lede {
    font-size: 18px;
    color: var(--wood-dark);
    max-width: 48ch;
  }

  .bio {
    background: var(--paper-dark);
  }
  .bio-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 56px;
  }
  .bio-copy h2 {
    font-size: clamp(24px, 3vw, 30px);
    margin-bottom: 18px;
  }
  .bio-copy p {
    color: var(--wood-dark);
    margin-bottom: 18px;
    max-width: 60ch;
  }
  .bio-facts {
    border-left: 2px solid var(--ember);
    padding-left: 22px;
  }
  .bio-facts ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bio-facts li {
    font-size: 14.5px;
    color: var(--wood-dark);
  }

  .timeline {
    background: var(--wood-dark);
  }
  .eyebrow-light {
    color: var(--ember-light);
  }
  .timeline-title {
    color: var(--white-smoke);
    font-size: clamp(26px, 3.2vw, 34px);
    margin: 10px 0 40px;
  }
  .hitos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .hitos li {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid rgba(237, 228, 211, 0.14);
  }
  .hitos li:last-child {
    border-bottom: 1px solid rgba(237, 228, 211, 0.14);
  }
  .hito-year {
    font-family: var(--font-mono);
    color: var(--ember-light);
    font-size: 15px;
  }
  .hitos p {
    color: var(--paper-dark);
    max-width: 56ch;
  }

  .cta-simple {
    background: var(--paper);
    text-align: center;
  }
  .cta-simple-inner h2 {
    font-size: clamp(24px, 3vw, 30px);
    margin-bottom: 22px;
  }

  @media (max-width: 860px) {
    .hero-page-grid,
    .bio-grid {
      grid-template-columns: 1fr;
    }
    .bio-facts {
      border-left: none;
      border-top: 2px solid var(--ember);
      padding-left: 0;
      padding-top: 18px;
    }
    .hitos li {
      grid-template-columns: 70px 1fr;
    }
  }
</style>