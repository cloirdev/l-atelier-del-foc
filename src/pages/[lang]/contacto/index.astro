---
import Layout from "../../../layouts/Layout.astro";
import BurntDivider from "../../../components/BurntDivider.astro";
import { languages } from "../../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("contacto.title")} description={t("contacto.desc")}>
  <section class="contact-hero">
    <div class="wrap">
      <p class="eyebrow">{t("contacto.eyebrow")}</p>
      <h1>{t("contacto.h1")}</h1>
      <p class="lede">{t("contacto.lede")}</p>
    </div>
  </section>

  <BurntDivider fill="var(--paper-dark)" />

  <section class="section contact-body">
    <div class="wrap contact-grid">
      <form
        class="contact-form"
        action="mailto:latelierdelfoc@gmail.com"
        method="post"
        enctype="text/plain"
      >
        <div class="field">
          <label for="nombre">{t("contacto.form.nombre")}</label>
          <input
            id="nombre"
            name="nombre"
            type="text"
            required
            autocomplete="off"
          />
        </div>
        <div class="field">
          <label for="email">{t("contacto.form.email")}</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="off"
          />
        </div>
        <div class="field">
          <label for="tipo">{t("contacto.form.tipo")}</label>
          <select id="tipo" name="tipo">
            <option>{t("contacto.form.tipo.fallaGrande")}</option>
            <option>{t("contacto.form.tipo.fallaInfantil")}</option>
            <option>{t("contacto.form.tipo.ninot")}</option>
            <option>{t("contacto.form.tipo.restauracion")}</option>
            <option>{t("contacto.form.tipo.taller")}</option>
            <option>{t("contacto.form.tipo.otro")}</option>
          </select>
        </div>
        <div class="field">
          <label for="mensaje">{t("contacto.form.mensaje")}</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="6"
            required
            placeholder={t("contacto.form.mensaje.placeholder")}></textarea>
        </div>
        <button type="submit" class="btn btn-primary"
          >{t("contacto.form.enviar")}</button
        >
        <p class="form-note">
          {t("contacto.form.nota")}
          <a href="mailto:latelierdelfoc@gmail.com">latelierdelfoc@gmail.com</a
          >.
        </p>
      </form>

      <aside class="contact-info">
        <div class="info-block">
          <p class="eyebrow">{t("contacto.info.taller.eyebrow")}</p>
          <p>
            {t("contacto.info.taller.text")}<br />{
              t("contacto.info.taller.visitas")
            }
          </p>
        </div>
        <div class="info-block">
          <p class="eyebrow">{t("contacto.info.correo.eyebrow")}</p>
          <p>
            <a href="mailto:latelierdelfoc@gmail.com"
              >latelierdelfoc@gmail.com</a
            >
          </p>
        </div>
        <div class="info-block">
          <p class="eyebrow">{t("contacto.info.plazos.eyebrow")}</p>
          <p>{t("contacto.info.plazos.text")}</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-hero {
    background: var(--paper);
    padding: 64px 0 48px;
  }
  h1 {
    font-size: clamp(38px, 5vw, 56px);
    margin: 10px 0 18px;
  }
  .lede {
    font-size: 17px;
    color: var(--wood-dark);
    max-width: 58ch;
  }

  .contact-body {
    background: var(--paper-dark);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 56px;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--wood-dark);
  }
  input,
  select,
  textarea {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 12px 14px;
    background: var(--white-smoke);
    border: 1.5px solid var(--wood);
    border-radius: 3px;
    color: var(--soot);
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--ember);
  }
  .contact-form .btn {
    width: fit-content;
    border: none;
    cursor: pointer;
    font-size: 13px;
  }
  .form-note {
    font-size: 13px;
    color: var(--wood);
  }
  .form-note a {
    border-bottom: 1px solid var(--ember);
    color: var(--ember);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .info-block p:not(.eyebrow) {
    color: var(--wood-dark);
    margin-top: 6px;
  }
  .info-block a {
    color: var(--ember);
    border-bottom: 1px solid var(--ember);
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
