---
import Layout from "../layouts/Layout.astro";
import BurntDivider from "../components/BurntDivider.astro";
import PlaceholderFrame from "../components/PlaceholderFrame.astro";

const steps = [
  {
    n: "01",
    label: "Boceto",
    text: "Cada falla nace en papel: idea, crítica y proporción antes de tocar el corcho.",
  },
  {
    n: "02",
    label: "Escultura",
    text: "Corcho blanco, cartón piedra y ferralla toman volumen en el taller, pieza a pieza.",
  },
  {
    n: "03",
    label: "Pintura",
    text: "Color, textura y acabado: el momento en que el ninot cobra carácter.",
  },
  {
    n: "04",
    label: "Cremà",
    text: "La noche del fuego. Lo que se construyó todo el año arde en minutos, y empieza de nuevo.",
  },
];

const piezas = [
  { label: "Falla Gran Vía", caption: "Falla grande · 2024" },
  { label: "El rellotger", caption: "Ninot individual · 2023" },
  { label: "Casal infantil", caption: "Falla infantil · 2024" },
];
---

<Layout title="Inicio">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Taller de arte fallero</p>
        <h1>
          Cada falla nace<br />
          del boceto<br />
          y muere en el <span class="ember-word">foc</span>.
        </h1>
        <p class="hero-sub">
          Dani diseña y construye fallas, ninots y escultura efímera para
          comisiones, casals y colecciones particulares. Un año de taller, una
          noche de fuego.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/servicios/">Encargar una pieza</a>
          <a class="btn btn-ghost" href="/galeria/">Ver la galería</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <svg viewBox="0 0 320 380" class="ember-art">
          <defs>
            <radialGradient id="glow" cx="50%" cy="35%" r="65%">
              <stop
                offset="0%"
                stop-color="var(--ember-light)"
                stop-opacity="0.5"></stop>
              <stop
                offset="100%"
                stop-color="var(--ember-light)"
                stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <circle cx="160" cy="150" r="140" fill="url(#glow)" class="pulse"
          ></circle>
          <path
            class="flame flame-a"
            d="M160 40c34 56-22 68-22 112 0 28 22 40 22 40s22-12 22-40c46 34 34 102-22 136-68-12-102-68-90-124 7-34 34-68 90-124z"
            fill="var(--ember)"></path>
          <path
            class="flame flame-b"
            d="M160 90c18 30-12 36-12 60 0 15 12 21 12 21s12-6 12-21c24 18 18 55-12 73-36-6-55-36-49-67 4-18 18-36 49-66z"
            fill="var(--ember-light)"></path>
        </svg>
      </div>
    </div>
  </section>

  <BurntDivider fill="var(--paper-dark)" />

  <section class="section about-teaser">
    <div class="wrap about-grid">
      <PlaceholderFrame
        label="Dani en el taller"
        caption="Retrato · pendiente"
        ratio="4/5"
      />
      <div class="about-copy">
        <p class="eyebrow">El artista</p>
        <h2>Once meses de banco de trabajo por una noche de fuego.</h2>
        <p>
          Dani lleva más de una década esculpiendo ninots en corcho blanco y
          cartón piedra, combinando la sátira tradicional fallera con formas y
          color contemporáneos. Cada encargo empieza con una conversación y
          termina, como manda la tradición, ardiendo en la cremà.
        </p>
        <a class="btn btn-ghost" href="/el-artista/">Conocer a Dani →</a>
      </div>
    </div>
  </section>

  <BurntDivider fill="var(--wood-dark)" flip />

  <section class="section process" id="proceso">
    <div class="wrap">
      <p class="eyebrow eyebrow-light">Cómo se hace una falla</p>
      <h2 class="process-title">Del papel al fuego, en cuatro fases</h2>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step">
              <span class="step-n">{s.n}</span>
              <h3>{s.label}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <BurntDivider fill="var(--paper)" />

  <section class="section gallery-teaser">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Trabajo reciente</p>
          <h2>Algunas piezas del taller</h2>
        </div>
        <a class="btn btn-ghost" href="/galeria/">Ver galería completa →</a>
      </div>
      <div class="pieces-grid">
        {
          piezas.map((p) => (
            <PlaceholderFrame label={p.label} caption={p.caption} ratio="4/5" />
          ))
        }
      </div>
    </div>
  </section>

  <BurntDivider fill="var(--soot)" flip />

  <section class="cta-band">
    <div class="wrap cta-inner">
      <h2>¿Tienes una idea para tu falla?</h2>
      <p>
        Cuéntasela a Dani. Encargos para fallas grandes, infantiles, ninots
        individuales y piezas para casals.
      </p>
      <a class="btn btn-primary" href="/contacto/">Escribir al taller</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: var(--paper);
    padding: 72px 0 64px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: center;
  }
  .hero-copy h1 {
    font-size: clamp(38px, 5.4vw, 62px);
    margin: 14px 0 22px;
  }
  .ember-word {
    color: var(--ember);
    font-style: italic;
  }
  .hero-sub {
    max-width: 46ch;
    font-size: 17.5px;
    color: var(--wood-dark);
    margin-bottom: 30px;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .ember-art {
    width: 100%;
    max-width: 320px;
  }
  .pulse {
    transform-origin: 160px 150px;
    animation: pulse 4.5s ease-in-out infinite;
  }
  .flame {
    transform-origin: 160px 200px;
  }
  .flame-a {
    animation: flicker 3.6s ease-in-out infinite;
  }
  .flame-b {
    animation: flicker 3.1s ease-in-out infinite reverse;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.06);
    }
  }
  @keyframes flicker {
    0%,
    100% {
      transform: skewX(0deg) scaleY(1);
    }
    30% {
      transform: skewX(-1.5deg) scaleY(1.02);
    }
    60% {
      transform: skewX(1.2deg) scaleY(0.98);
    }
  }

  .about-teaser {
    background: var(--paper-dark);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: center;
  }
  .about-copy h2 {
    font-size: clamp(26px, 3.2vw, 34px);
    margin: 10px 0 18px;
  }
  .about-copy p:not(.eyebrow) {
    color: var(--wood-dark);
    margin-bottom: 22px;
    max-width: 52ch;
  }

  .process {
    background: var(--wood-dark);
    color: var(--paper-dark);
  }
  .eyebrow-light {
    color: var(--ember-light);
  }
  .process-title {
    color: var(--white-smoke);
    font-size: clamp(26px, 3.2vw, 36px);
    margin: 10px 0 44px;
    max-width: 20ch;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .step {
    border-top: 2px solid var(--ember);
    padding-top: 16px;
  }
  .step-n {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ember-light);
    margin-bottom: 10px;
  }
  .step h3 {
    color: var(--white-smoke);
    font-size: 20px;
    margin-bottom: 8px;
  }
  .step p {
    color: var(--cork);
    font-size: 14.5px;
  }

  .gallery-teaser {
    background: var(--paper);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .section-head h2 {
    font-size: clamp(26px, 3.2vw, 34px);
    margin-top: 8px;
  }
  .pieces-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .cta-band {
    background: var(--soot);
    padding: 80px 0 92px;
  }
  .cta-inner {
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
  }
  .cta-inner h2 {
    color: var(--white-smoke);
    font-size: clamp(28px, 3.6vw, 40px);
    margin-bottom: 16px;
  }
  .cta-inner p {
    color: var(--cork);
    margin-bottom: 30px;
    font-size: 16px;
  }
  .cta-inner .btn-primary {
  }

  @media (max-width: 900px) {
    .hero-grid,
    .about-grid {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      order: -1;
      max-width: 220px;
      margin: 0 auto;
    }
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .pieces-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .pieces-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
