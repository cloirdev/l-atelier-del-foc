---
import Layout from "../../layouts/Layout.astro";
import BurntDivider from "../../components/BurntDivider.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const fallas = await getCollection("fallas");
  return fallas.map((falla) => ({
    params: { slug: falla.id },
    props: { falla },
  }));
}

const { falla } = Astro.props;
const { falla: nombre, año, lema, seccion, casal, premios, foto } = falla.data;

const { Content } = await render(falla);
---

<Layout
  title={`${nombre} (${año})`}
  description={lema ?? `Ficha de la falla ${nombre}, ${año}.`}
>
  <section class="ficha-hero">
    <div class="wrap">
      <a href="/colecciones/" class="volver">
        <span aria-hidden="true">←</span> Volver a colecciones
      </a>

      <div class="ficha-encabezado">
        <p class="eyebrow">{año} · {seccion}</p>
        <h1>{nombre}</h1>
        {lema && <p class="lede">&ldquo;{lema}&rdquo;</p>}
      </div>

      {
        foto && (
          <div class="ficha-foto">
            <Image
              src={foto}
              alt={`Falla ${nombre}, ${año}`}
              width={1120}
              height={700}
            />
          </div>
        )
      }

      <dl class="ficha-datos">
        {
          casal && (
            <div class="dato">
              <dt>Casal</dt>
              <dd>{casal}</dd>
            </div>
          )
        }
        <div class="dato">
          <dt>Sección</dt>
          <dd>{seccion}</dd>
        </div>
        {
          premios.length > 0 && (
            <div class="dato dato-premios">
              <dt>Premios</dt>
              <dd>
                <ul class="lista-premios">
                  {premios.map((p: string) => (
                    <li class="tag">{p}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>

  <BurntDivider fill="var(--paper-dark)" />

  <section class="section ficha-body">
    <div class="wrap prose">
      <Content />
    </div>
  </section>
</Layout>

<style>
  .ficha-hero {
    background: var(--paper);
    padding: 64px 0 48px;
  }

  .ficha-hero .wrap {
    max-width: 780px;
  }

  /* Volver */
  .volver {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--wood-dark);
    margin-bottom: 32px;
    transition:
      color 0.2s ease,
      gap 0.2s ease;
  }
  .volver:hover {
    color: var(--ember);
    gap: 9px;
  }
  .volver span {
    transition: transform 0.2s ease;
  }
  .volver:hover span {
    transform: translateX(-2px);
  }

  /* Encabezado */
  .ficha-encabezado {
    margin-bottom: 36px;
  }

  .ficha-encabezado .eyebrow {
    margin-bottom: 10px;
    display: block;
  }

  h1 {
    font-size: clamp(34px, 4.5vw, 52px);
    margin-bottom: 14px;
  }

  .lede {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 20px;
    line-height: 1.5;
    color: var(--wood-dark);
    max-width: 52ch;
  }

  /* Foto: marco sobrio, sin esquinas muy redondeadas ni sombras pesadas */
  .ficha-foto {
    margin-bottom: 36px;
    border: 1px solid var(--cork);
    border-radius: var(--radius-sm);
    padding: 6px;
    background: var(--white-smoke);
  }
  .ficha-foto img {
    border-radius: 2px;
    width: 100%;
    height: auto;
  }

  /* Ficha de datos: como una etiqueta técnica sobre madera/papel */
  .ficha-datos {
    display: grid;
    gap: 20px 40px;
    grid-template-columns: repeat(auto-fit, minmax(150px, max-content));
    padding: 24px 28px;
    margin: 0;
    background: var(--paper-dark);
    border: 1px solid var(--cork);
    border-radius: var(--radius-sm);
  }

  .dato {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .dato-premios {
    flex: 1 1 100%;
    grid-column: 1 / -1;
  }

  .ficha-datos dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--wood-dark);
  }

  .ficha-datos dd {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
  }

  .lista-premios {
    list-style: none;
    margin: 2px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Reutiliza .tag pero en el tono ember, para distinguir premios de secciones */
  .lista-premios li.tag {
    border-color: var(--ember);
    color: var(--wood-dark);
    background: var(--paper);
    font-size: 12.5px;
  }

  /* Cuerpo */
  .ficha-body {
    background: var(--paper-dark);
  }

  .prose {
    max-width: 68ch;
    font-size: 17px;
    line-height: 1.75;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2em;
    margin-bottom: 0.6em;
  }

  .prose :global(p) {
    margin-bottom: 1.2em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.4em;
  }

  @media (max-width: 640px) {
    .ficha-hero {
      padding: 44px 0 32px;
    }
    .ficha-datos {
      grid-template-columns: 1fr;
      padding: 20px;
      gap: 18px;
    }
    .lede {
      font-size: 17px;
    }
  }
</style>
