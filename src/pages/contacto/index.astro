---
import Layout from "../../layouts/Layout.astro";
import BurntDivider from "../../components/BurntDivider.astro";
---

<Layout
  title="Contacto"
  description="Contacta con l'Atelier del Foc para encargos, presupuestos o visitas al taller."
>
  <section class="contact-hero">
    <div class="wrap">
      <p class="eyebrow">Hablemos</p>
      <h1>Contacto</h1>
      <p class="lede">
        ¿Tienes una idea para tu falla, un ninot en mente o quieres visitar el
        taller? Escribe a Dani y te contesta en un par de días.
      </p>
    </div>
  </section>

  <BurntDivider fill="var(--paper-dark)" />

  <section class="section contact-body">
    <div class="wrap contact-grid">
      <form
        class="contact-form"
        action="mailto:hola@atelierdelfoc.com"
        method="post"
        enctype="text/plain"
      >
        <div class="field">
          <label for="nombre">Nombre</label>
          <input
            id="nombre"
            name="nombre"
            type="text"
            required
            autocomplete="off"
          />
        </div>
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="off"
          />
        </div>
        <div class="field">
          <label for="tipo">Tipo de encargo</label>
          <select id="tipo" name="tipo">
            <option>Falla grande</option>
            <option>Falla infantil</option>
            <option>Ninot individual</option>
            <option>Restauración</option>
            <option>Taller de iniciación</option>
            <option>Otro</option>
          </select>
        </div>
        <div class="field">
          <label for="mensaje">Cuéntale a Dani tu idea</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="6"
            required
            placeholder="Escala aproximada, plazo, presupuesto orientativo, referencias..."
          ></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Enviar mensaje</button>
        <p class="form-note">
          Este formulario abre tu gestor de correo. Si prefieres, escribe
          directamente a
          <a href="mailto:hola@atelierdelfoc.com">hola@atelierdelfoc.com</a>.
        </p>
      </form>

      <aside class="contact-info">
        <div class="info-block">
          <p class="eyebrow">Taller</p>
          <p>l'Atelier del Foc<br />Visitas con cita previa</p>
        </div>
        <div class="info-block">
          <p class="eyebrow">Correo</p>
          <p>
            <a href="mailto:hola@atelierdelfoc.com">hola@atelierdelfoc.com</a>
          </p>
        </div>
        <div class="info-block">
          <p class="eyebrow">Plazos</p>
          <p>
            Los encargos de falla grande e infantil se reservan con meses de
            antelación, sobre todo de cara a marzo.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-hero {
    background: var(--paper);
    padding: 64px 0 48px;
  }
  h1 {
    font-size: clamp(38px, 5vw, 56px);
    margin: 10px 0 18px;
  }
  .lede {
    font-size: 17px;
    color: var(--wood-dark);
    max-width: 58ch;
  }

  .contact-body {
    background: var(--paper-dark);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 56px;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--wood-dark);
  }
  input,
  select,
  textarea {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 12px 14px;
    background: var(--white-smoke);
    border: 1.5px solid var(--wood);
    border-radius: 3px;
    color: var(--soot);
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--ember);
  }
  .contact-form .btn {
    width: fit-content;
    border: none;
    cursor: pointer;
    font-size: 13px;
  }
  .form-note {
    font-size: 13px;
    color: var(--wood);
  }
  .form-note a {
    border-bottom: 1px solid var(--ember);
    color: var(--ember);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .info-block p:not(.eyebrow) {
    color: var(--wood-dark);
    margin-top: 6px;
  }
  .info-block a {
    color: var(--ember);
    border-bottom: 1px solid var(--ember);
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
