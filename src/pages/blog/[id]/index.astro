---
import Layout from '../../../layouts/Layout.astro';
import BurntDivider from '../../../components/BurntDivider.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title={post.data.title} description={post.data.description}>
  <article>
    <section class="post-hero">
      <div class="wrap">
        <a class="back" href="/blog/">← Bitácora</a>
        <div class="post-meta">
          <span class="tag">{post.data.tag}</span>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        </div>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
      </div>
    </section>

    <BurntDivider fill="var(--paper-dark)" />

    <section class="section post-body">
      <div class="wrap prose">
        <Content />
      </div>
    </section>
  </article>
</Layout>

<style>
  .post-hero { background: var(--paper); padding: 56px 0 48px; }
  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ember);
    margin-bottom: 24px;
  }
  .post-meta { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
  .post-meta time { font-family: var(--font-mono); font-size: 12.5px; color: var(--wood); }
  h1 { font-size: clamp(32px, 4.6vw, 48px); margin-bottom: 16px; max-width: 22ch; }
  .lede { font-size: 17px; color: var(--wood-dark); max-width: 58ch; }

  .post-body { background: var(--paper-dark); }
  .prose { max-width: 68ch; }
  .prose :global(h2) {
    font-size: 24px;
    margin-top: 40px;
    margin-bottom: 14px;
  }
  .prose :global(p) {
    color: var(--wood-dark);
    margin-bottom: 18px;
    font-size: 16.5px;
    line-height: 1.7;
  }
</style>
