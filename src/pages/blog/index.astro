---
import Layout from '../../layouts/Layout.astro';
import BurntDivider from '../../components/BurntDivider.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title="Bitácora" description="Notas, avances y crónicas de l'Atelier del Foc.">
  <section class="blog-hero">
    <div class="wrap">
      <p class="eyebrow">Diario de taller</p>
      <h1>Bitácora</h1>
      <p class="lede">
        Avances de piezas en marcha, crónicas de cremà y alguna nota sobre el oficio.
        Sin calendario fijo: se publica cuando hay algo que contar.
      </p>
    </div>
  </section>

  <BurntDivider fill="var(--paper-dark)" />

  <section class="section post-list">
    <div class="wrap">
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="post-link">
              <div class="post-meta">
                <span class="tag">{post.data.tag}</span>
                <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="read-more">Leer entrada →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .blog-hero { background: var(--paper); padding: 64px 0 48px; }
  h1 { font-size: clamp(38px, 5vw, 56px); margin: 10px 0 18px; }
  .lede { font-size: 17px; color: var(--wood-dark); max-width: 58ch; }

  .post-list { background: var(--paper-dark); }
  .posts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .posts li { border-top: 1px solid rgba(74,52,35,0.16); }
  .posts li:last-child { border-bottom: 1px solid rgba(74,52,35,0.16); }
  .post-link {
    display: block;
    padding: 30px 4px;
    transition: padding-left 0.2s ease;
  }
  .post-link:hover { padding-left: 12px; }
  .post-meta { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
  .post-meta time { font-family: var(--font-mono); font-size: 12.5px; color: var(--wood); }
  .post-link h2 { font-size: 24px; margin-bottom: 8px; }
  .post-link p { color: var(--wood-dark); max-width: 64ch; margin-bottom: 10px; }
  .read-more { font-family: var(--font-mono); font-size: 12.5px; color: var(--ember); text-transform: uppercase; letter-spacing: 0.05em; }
</style>
