---
import Layout from '../../layouts/Layout.astro';
import BurntDivider from '../../components/BurntDivider.astro';
import PlaceholderFrame from '../../components/PlaceholderFrame.astro';

const piezas = [
  { label: 'Falla Gran Vía', caption: 'Falla grande · 2024', ratio: '4/5' },
  { label: 'El rellotger', caption: 'Ninot individual · 2023', ratio: '3/4' },
  { label: 'Casal infantil', caption: 'Falla infantil · 2024', ratio: '4/5' },
  { label: 'La barraqueta', caption: 'Boceto a escultura · 2022', ratio: '4/5' },
  { label: 'Sàtira municipal', caption: 'Falla grande · 2021', ratio: '3/4' },
  { label: 'Ninot indultat', caption: 'Pieza premiada · 2023', ratio: '4/5' },
  { label: 'Taller abierto', caption: 'Proceso · 2024', ratio: '4/5' },
  { label: 'Detalle de pintura', caption: 'Acabados · 2024', ratio: '3/4' },
  { label: 'Cremà', caption: 'Noche del fuego · 2023', ratio: '4/5' },
];

const filtros = ['Todo', 'Fallas grandes', 'Fallas infantiles', 'Ninots', 'Proceso'];
---
<Layout title="Galería" description="Fallas, ninots y proceso de taller de Dani, artista fallero de l'Atelier del Foc.">
  <section class="gal-hero">
    <div class="wrap">
      <p class="eyebrow">Portfolio</p>
      <h1>Galería</h1>
      <p class="lede">
        Una selección del trabajo del taller: fallas grandes, infantiles, ninots individuales
        y algo de proceso. Las fotos reales de cada pieza se irán añadiendo aquí — de momento,
        marcos a la espera de imagen.
      </p>
      <div class="filters" role="tablist" aria-label="Filtrar por categoría">
        {filtros.map((f, i) => (
          <button type="button" class:list={[{ active: i === 0 }]}>{f}</button>
        ))}
      </div>
    </div>
  </section>

  <BurntDivider fill="var(--paper-dark)" />

  <section class="section gal-grid-section">
    <div class="wrap">
      <div class="gal-grid">
        {piezas.map(p => (
          <PlaceholderFrame label={p.label} caption={p.caption} ratio={p.ratio} />
        ))}
      </div>
    </div>
  </section>

  <BurntDivider fill="var(--soot)" flip />

  <section class="cta-band">
    <div class="wrap cta-inner">
      <h2>¿Buscas algo parecido para tu falla?</h2>
      <p>Cada pieza del taller empieza con una idea concreta. Cuéntale la tuya a Dani.</p>
      <a class="btn btn-primary" href="/contacto/">Hablar del encargo</a>
    </div>
  </section>
</Layout>

<style>
  .gal-hero { background: var(--paper); padding: 64px 0 44px; }
  h1 { font-size: clamp(40px, 5.6vw, 60px); margin: 10px 0 18px; }
  .lede { font-size: 17px; color: var(--wood-dark); max-width: 62ch; margin-bottom: 30px; }
  .filters { display: flex; gap: 10px; flex-wrap: wrap; }
  .filters button {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1.5px solid var(--wood);
    background: transparent;
    color: var(--wood-dark);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .filters button.active,
  .filters button:hover {
    background: var(--ember);
    border-color: var(--ember);
    color: var(--white-smoke);
  }

  .gal-grid-section { background: var(--paper-dark); }
  .gal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px 26px;
  }

  .cta-band { background: var(--soot); padding: 80px 0 92px; }
  .cta-inner { text-align: center; max-width: 560px; margin: 0 auto; }
  .cta-inner h2 { color: var(--white-smoke); font-size: clamp(26px, 3.4vw, 36px); margin-bottom: 14px; }
  .cta-inner p { color: var(--cork); margin-bottom: 28px; }

  @media (max-width: 900px) {
    .gal-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .gal-grid { grid-template-columns: 1fr; }
  }
</style>
